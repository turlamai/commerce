#lang racket/base

;; Opt-in operator diagnostic, not a public payment/administration API.
;; Exact requests are encrypted; logs contain only allowlisted metadata.
(provide make-alipay-notify-observer capture-notify! read-notify-capture
         handle-observed-alipay-notify serve-observed-alipay-notify)
(require base64 crypto crypto/libcrypto json racket/file racket/port racket/string
         net/url web-server/http web-server/servlet-env commerce/alipay/server)
(struct observer (directory key limit max-bytes lock))
(define (refuse) (error 'alipay-notify-observer "private notification capture unavailable"))
(define (make-alipay-notify-observer directory key #:max-records [limit 256]
                                     #:max-body-bytes [max-bytes 65536])
  (unless (and (path-string? directory) (directory-exists? directory)
               (bytes? key) (= (bytes-length key) 32)
               (exact-positive-integer? limit) (<= limit 4096)
               (exact-positive-integer? max-bytes) (<= max-bytes 65536)) (refuse))
  (when (and (memq (system-type 'os) '(unix macosx))
             (not (zero? (bitwise-and #o077 (file-or-directory-permissions directory 'bits)))))
    (refuse))
  (observer directory (bytes->immutable-bytes key) limit max-bytes (make-semaphore 1)))
(define (capture-path o id)
  (unless (and (string? id) (regexp-match? #px"^[0-9]+-[a-f0-9]{16}$" id)) (refuse))
  (build-path (observer-directory o) (string-append id ".capture.json")))
;; Windows privacy relies on the operator-provisioned directory ACL.
(define private-file-mode (if (eq? (system-type) 'windows) #o666 #o600))
(define (private-write path data)
  (call-with-output-file path #:exists 'error #:permissions private-file-mode
    (lambda (out) (write-json data out))))
(define (audit! o data)
  (call-with-output-file (build-path (observer-directory o) "events.jsonl")
    #:exists 'append #:permissions private-file-mode
    (lambda (out) (write-json data out) (newline out))))
(define (b64 b) (bytes->string/utf-8 (base64-encode b #:line #f)))
(define (un64 s) (base64-decode (string->bytes/utf-8 s)))
(define (capture-notify! o raw content-type)
  (with-handlers ([exn:fail? (lambda (_) (refuse))])
    (capture-notify/internal! o raw content-type)))
(define (capture-notify/internal! o input content-type)
  (define raw (and (bytes? input) (bytes->immutable-bytes input)))
  (unless (and (observer? o) (bytes? raw)
               (<= (bytes-length raw) (observer-max-bytes o))) (refuse))
  (call-with-semaphore (observer-lock o)
   (lambda ()
    (define records (filter (lambda (p) (regexp-match? #rx"[.]capture[.]json$" (path->string p)))
                            (directory-list (observer-directory o))))
    (when (>= (length records) (observer-limit o)) (refuse))
    (define id (format "~a-~a" (current-milliseconds) (bytes->hex-string (crypto-random-bytes 8))))
    (define meta (hasheq 'id id 'phase "received" 'received_at (current-seconds)
       'body_bytes (bytes-length raw) 'sha256 (bytes->hex-string (sha256-bytes raw))
       'content_type (if (and (string? content-type) (regexp-match? #px"^application/x-www-form-urlencoded(?:;|$)" content-type)) "form" "other")))
    (define aad (jsexpr->bytes meta))
    (define nonce (crypto-random-bytes 12))
    (define-values (encrypted tag)
      (parameterize ([crypto-factories (list libcrypto-factory)])
        (encrypt/auth '(aes gcm) (observer-key o) nonce raw #:aad aad #:auth-size 16)))
    (private-write (capture-path o id) (hasheq 'version 1 'algorithm "AES-256-GCM"
       'aad (b64 aad) 'nonce (b64 nonce) 'ciphertext (b64 encrypted) 'tag (b64 tag)))
    (audit! o meta)
    id)))
(define (read-notify-capture o id)
  (with-handlers ([exn:fail? (lambda (_) (refuse))])
    (read-notify-capture/internal o id)))
(define (read-notify-capture/internal o id)
  (define path (capture-path o id))
  (unless (<= (file-size path) 131072) (refuse))
  (define data (call-with-input-file path read-json))
  (unless (and (equal? (hash-ref data 'version #f) 1)
               (equal? (hash-ref data 'algorithm #f) "AES-256-GCM")) (refuse))
  (define aad (un64 (hash-ref data 'aad)))
  (define meta (read-json (open-input-bytes aad)))
  (unless (equal? (hash-ref meta 'id #f) id) (refuse))
  (parameterize ([crypto-factories (list libcrypto-factory)])
    (decrypt/auth '(aes gcm) (observer-key o) (un64 (hash-ref data 'nonce))
      (un64 (hash-ref data 'ciphertext)) #:aad aad #:auth-tag (un64 (hash-ref data 'tag)))))
(define (handle-observed-alipay-notify o endpoint method path content-type raw)
  (with-handlers ([exn:fail? (lambda (_) (values 503 #"failure"))])
   (cond
    [(not (equal? path "/webhooks/alipay")) (values 404 #"failure")]
    [(not (equal? method #"POST")) (values 405 #"failure")]
    [(or (not (bytes? raw)) (> (bytes-length raw) (observer-max-bytes o))) (values 413 #"failure")]
    [else
     (define snapshot (bytes->immutable-bytes raw))
     (define id (capture-notify! o snapshot content-type))
     (define-values (status body)
       (if (and (string? content-type) (regexp-match? #px"^application/x-www-form-urlencoded(?:;|$)" content-type))
           (handle-alipay-webhook-post endpoint snapshot)
           (values 415 #"failure")))
     (call-with-semaphore (observer-lock o)
       (lambda () (audit! o (hasheq 'id id 'phase "handled" 'handled_at (current-seconds)
         'status status 'ack (if (bytes=? body #"success") "success" "failure")))))
     (values status body)])))
(define (serve-observed-alipay-notify o endpoint #:port port)
  (define owner (make-custodian))
  (parameterize ([current-custodian owner])
   (thread
    (lambda ()
     (serve/servlet
      (lambda (request)
       (define header-value* (headers-assq* #"content-type" (request-headers/raw request)))
       (define-values (status body)
        (handle-observed-alipay-notify o endpoint (request-method request)
          (url->string (request-uri request))
          (and header-value* (bytes->string/utf-8 (header-value header-value*) #\?))
          (or (request-post-data/raw request) #"")))
       (response/full status #f (current-seconds) #"text/plain; charset=utf-8" '() (list body)))
      #:port port #:listen-ip "127.0.0.1" #:command-line? #f
      #:launch-browser? #f #:quit? #f #:banner? #f #:servlet-regexp #rx""))))
  (lambda () (custodian-shutdown-all owner)))
