# Commerce authenticated hosted checkout edge (loopback only)
ALIPAY_ENV=sandbox
ALIPAY_APP_ID=replace-with-sandbox-app-id
ALIPAY_SELLER_ID=replace-with-matching-seller-id
ALIPAY_PRIVATE_KEY_PATH=/secure/alipay/sandbox-merchant-private-key.pem
ALIPAY_NOTIFY_URL=https://your-approved-domain.example/webhooks/alipay
ALIPAY_RETURN_URL=https://your-approved-domain.example/hosted/return
COMMERCE_PROVIDER_ADMISSION_PATH=/secure/commerce/alipay-admission.json
COMMERCE_DATABASE_PATH=/var/lib/commerce/commerce.sqlite
COMMERCE_REPLAY_DB_PATH=/var/lib/commerce/hosted-replay.sqlite
COMMERCE_SERVICE_ID=publy
COMMERCE_SERVICE_HMAC_PATH=/secure/commerce/publy.hmac
COMMERCE_ISSUER=publy
COMMERCE_HTTP_PORT=8765
