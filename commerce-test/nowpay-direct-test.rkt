#lang racket/base
(require rackunit json crypto crypto/libcrypto base64 racket/string
         commerce commerce/alipay commerce/nowpay-direct)

(define (key)
  (parameterize ([crypto-factories (list libcrypto-factory)])
    (generate-private-key (get-pk 'rsa) '((nbits 2048)))))
(define merchant (key))
(define provider (key))
(define (pem k)
  (string-append "-----BEGIN PUBLIC KEY-----\n"
    (bytes->string/utf-8 (base64-encode (pk-key->datum (pk-key->public-only-key k) 'SubjectPublicKeyInfo) #:line #f))
    "\n-----END PUBLIC KEY-----\n"))
(define (response node body #:key [k provider])
  (define text (if (string? body) body (jsexpr->string body)))
  (define sig (digest/sign k 'sha256 (string->bytes/utf-8 text) #:pad 'pkcs1-v1.5))
  (string->bytes/utf-8
   (string-append "{\"" node "\":" text ",\"sign\":\""
    (bytes->string/utf-8 (base64-encode sig #:line #f)) "\"}")))
(define option (hasheq 'sku_id "sku_synthetic_month" 'display_name "Personal" 'price "29.00" 'duration_period "MONTH"))
(define charge (hasheq 'code "10000" 'capability_status "ENABLED" 'billing_mode "ONE_TIME_DURATION" 'charging_options (list option)))
(define allow (hasheq 'code "10000" 'decision "ALLOW" 'capability_status "ENABLED" 'valid_from "2026-11-01 08:00:00" 'valid_until "2026-12-01 08:00:00" 'charging_options (list option)))
(define seen '())
(define (client #:charge [c charge] #:consult [a allow] #:response-key [response-key provider])
  (make-nowpay-direct-client
   #:app-id "app_synthetic" #:merchant-private-key merchant #:alipay-public-key (pem provider)
   #:out-product-id "DIRECT_synthetic" #:price-minor 2900
   #:callback-url "https://app.example.com/hosted/return"
   #:clock (lambda () 1795392000)
   #:transport
   (lambda (url body)
     (check-equal? url "https://openapi.alipay.com/gateway.do")
     (define params (parse-alipay-form body))
     (define signature (base64-decode (string->bytes/utf-8 (cdr (assoc "sign" params)))))
     ;; Independently rebuild the exact OpenAPI request, including sign_type.
     (define text (string-join (for/list ([p (in-list (sort params string<? #:key car))] #:unless (equal? (car p) "sign")) (string-append (car p) "=" (cdr p))) "&"))
     (check-true (digest/verify (pk-key->public-only-key merchant) 'sha256 (string->bytes/utf-8 text) signature #:pad 'pkcs1-v1.5))
     (define method (cdr (assoc "method" params)))
     (define biz (string->jsexpr (cdr (assoc "biz_content" params))))
     (check-equal? (hash-ref biz 'out_product_id) "DIRECT_synthetic")
     (set! seen (cons (cons method biz) seen))
     (values 200 (if (string=? method "alipay.aipay.nowpaydirect.charge.query")
       (response "alipay_aipay_nowpaydirect_charge_query_response" c #:key response-key)
       (response "alipay_aipay_nowpaydirect_purchase_consult_response" a #:key response-key))))))

(define c (client))
(module+ test-support (provide client allow charge option))
(define catalog (nowpay-direct-charge-query c))
(check-true (nowpay-charge-purchasable? catalog))
(check-equal? (nowpay-charge-sku-id catalog) "sku_synthetic_month")
(define access (nowpay-direct-purchase-consult c "usr_synthetic"))
(check-equal? (nowpay-access-decision access) "ALLOW")
(check-equal? (nowpay-access-buyer-id access) "usr_synthetic")
(check-equal? (nowpay-access-valid-from access) 1793491200)
(check-equal? (nowpay-access-valid-until access) 1796083200)
(check-equal? (hash-ref (cdar seen) 'external_buyer_id) "usr_synthetic")
(check-false (nowpay-access-purchase-url access))
(define (failure? e) (and (exn:fail:commerce? e) (regexp-match? #rx"^nowpay-direct" (symbol->string (exn:fail:commerce-code e)))))
(check-exn failure? (lambda () (nowpay-direct-charge-query (client #:response-key merchant))))
(check-exn failure? (lambda () (nowpay-direct-charge-query (client #:charge (hash-set charge 'billing_mode "ONE_TIME")))))
(check-exn failure? (lambda () (nowpay-direct-charge-query (client #:charge (hash-set charge 'charging_options (list (hash-set option 'price "29.001")))))))
(check-exn failure? (lambda () (nowpay-direct-charge-query (client #:charge (hash-set charge 'charging_options (list option option))))))
(check-exn failure? (lambda () (nowpay-direct-purchase-consult (client #:consult (hash-set allow 'valid_until "2026-11-01 08:00:00")) "usr_synthetic")))
(check-exn failure? (lambda () (nowpay-direct-purchase-consult (client #:consult (hash-set allow 'valid_from "2026-11-25 08:00:00")) "usr_synthetic")))
(check-exn failure? (lambda () (nowpay-direct-purchase-consult c "private\ncanary")))
(check-exn failure? (lambda () (nowpay-direct-purchase-consult (client #:consult "{\"code\":\"10000\",\"decision\":\"DENY\",\"decision\":\"ALLOW\"}") "usr_synthetic")))
(define disabled (client #:charge (hash-set charge 'capability_status "DISABLED") #:consult (hash-set allow 'capability_status "DISABLED")))
(check-false (nowpay-charge-purchasable? (nowpay-direct-charge-query disabled)))
(check-equal? (nowpay-access-decision (nowpay-direct-purchase-consult disabled "usr_synthetic")) "ALLOW")
(define purchase (hasheq 'code "10000" 'decision "PURCHASE_REQUIRED" 'capability_status "ENABLED" 'charging_options (list option) 'purchase_url "alipays://platformapi/startapp?appId=synthetic"))
(check-equal? (nowpay-access-purchase-url (nowpay-direct-purchase-consult (client #:consult purchase) "usr_synthetic")) "alipays://platformapi/startapp?appId=synthetic")
(check-false (nowpay-access-purchase-url (nowpay-direct-purchase-consult (client #:consult (hash-set purchase 'capability_status "DISABLED")) "usr_synthetic")))
(check-exn failure? (lambda () (nowpay-direct-purchase-consult (client #:consult (hash-set purchase 'purchase_url "https://evil.example/collect")) "usr_synthetic")))
(check-false (regexp-match? #rx"usr_synthetic|DIRECT_synthetic|BEGIN PUBLIC KEY" (format "~a ~a" c access)))
