#lang racket/base
(require rackunit base64 json racket/file racket/string net/uri-codec
 crypto crypto/libcrypto commerce commerce/alipay commerce/alipay/reconcile
 commerce/journal commerce/storage commerce/storage/sqlite commerce/permit
 commerce/evidence commerce/issuer permit/issuer commerce/alipay/server
 (prefix-in record: commerce/private/journal-model))
(define key (parameterize ([crypto-factories (list libcrypto-factory)]) (generate-private-key (get-pk 'rsa) '((nbits 2048)))))
(define pem (string-append "-----BEGIN PUBLIC KEY-----\n" (bytes->string/utf-8 (base64-encode (pk-key->datum (pk-key->public-only-key key) 'SubjectPublicKeyInfo) #:line #f)) "\n-----END PUBLIC KEY-----\n"))
(define (sign s) (bytes->string/utf-8 (base64-encode (parameterize ([crypto-factories (list libcrypto-factory)]) (digest/sign key 'sha256 (string->bytes/utf-8 s) #:pad 'pkcs1-v1.5)) #:line #f)))
(define binding (alipay-binding "app" "seller" "order" "test-offer" "subject" (money "CNY" 2900)))
(define (return-form #:app [app "app"] #:seller [seller "seller"] #:trade [trade "trade"] #:amount [amount "29.00"])
 (define f (list (cons "app_id" app) (cons "seller_id" seller) (cons "out_trade_no" "order") (cons "trade_no" trade)
  (cons "total_amount" amount) (cons "sign_type" "RSA2") (cons "method" "alipay.trade.page.pay.return") (cons "version" "1.0") (cons "charset" "GBK") (cons "timestamp" "2026-11-15 20:00:00")))
 (string->bytes/utf-8 (alist->form-urlencoded (for/list ([p (in-list (cons (cons "sign" (sign (alipay-signing-content f))) f))]) (cons (string->symbol (car p)) (cdr p))))))
(define (query #:status [status "TRADE_SUCCESS"] #:trade [trade "trade"] #:amount [amount "29.00"] #:time [time "2026-11-15 19:59:00"] #:message [message "Success"])
 (define content (jsexpr->string (hasheq 'code "10000" 'out_trade_no "order" 'trade_no trade 'trade_status status 'total_amount amount 'send_pay_date time 'msg message)))
 (string->bytes/utf-8 (string-append "{\"alipay_trade_query_response\":" content ",\"sign\":\"" (sign content) "\"}")))
(define raw (return-form))
(define (refused? e) (exn:fail:commerce? e))
(define tampered-return (string->bytes/utf-8 (string-replace (bytes->string/utf-8 raw) "29.00" "0.01")))
(define tampered-query (string->bytes/utf-8 (string-replace (bytes->string/utf-8 (query)) "29.00" "0.01")))
(test-case "both provider signatures and all merchant/payment bindings are required"
 (check-true (payment-event? (verify-alipay-return-query raw (query) pem binding)))
 (for ([r (in-list (list tampered-return #"total_amount=29.00" (bytes-append raw #"&app_id=forged") (return-form #:app "wrong") (return-form #:seller "wrong") (return-form #:trade "wrong") (return-form #:amount "0.01")))])
  (check-exn refused? (lambda () (verify-alipay-return-query r (query) pem binding))))
 (for ([q (in-list (list tampered-query #"{}" (query #:status "WAIT_BUYER_PAY") (query #:status "TRADE_CLOSED") (query #:trade "wrong") (query #:amount "0.01") (query #:time "invalid")))])
  (check-exn refused? (lambda () (verify-alipay-return-query raw q pem binding)))))
(test-case "durable replay, offline issuer proof and evidence tamper rejection"
 (define dir (make-temporary-file "alipay-reconcile-~a" 'directory))
 (dynamic-wind void (lambda ()
  (define db (open-sqlite-commerce-storage (build-path dir "ledger.sqlite")))
  (dynamic-wind void (lambda ()
   (storage-create-checkout-binding! db (checkout-binding "order" "alipay" "test" "test-offer" "subject" "CNY" 2900 2) #:created-at 1)
   (define-values (private public) (generate-ed25519-keypair))
   (define trust (jsexpr->trust-store (hasheq 'protocol "permit-trust-store" 'version 1 'issuer "test-issuer" 'keys (hasheq 'test (hasheq 'algorithm "Ed25519" 'public_key (public-key->base64 public) 'status "active" 'purposes '("entitlement") 'not_before 'null 'not_after 'null)))))
   (define catalog (make-permit-policy-catalog (list (offer "test-offer" "test" 'one-time (money "CNY" 2900) "test-policy")) (list (make-permit-entitlement-policy "test-policy" 1 #:subject-type 'account #:grants (list (make-permit-grant-policy #:products '("test") #:edition "personal"))))))
   (define verifier (make-issuance-evidence-verifier #:catalog catalog #:alipay-public-key-pem pem #:alipay-app-id "app" #:alipay-seller-id "seller" #:binding-lookup (lambda (o) (storage-checkout-binding-ref db o))))
   (define network-calls 0)
   (check-exn refused? (lambda () (reconcile-alipay-signed-return! db tampered-return pem binding
      #:fetch-query (lambda (_) (set! network-calls (add1 network-calls)) (query)))))
   (check-equal? network-calls 0)
   (define first (reconcile-alipay-signed-return! db raw pem binding #:fetch-query (lambda (_) (query))))
   (check-eq? (journal-acceptance-disposition first) 'accepted)
   (check-eq? (journal-acceptance-disposition (reconcile-alipay-signed-return! db raw pem binding #:fetch-query (lambda (_) (query)))) 'replayed)
   (check-eq? (journal-acceptance-disposition (reconcile-alipay-signed-return! db raw pem binding #:fetch-query (lambda (_) (query #:message "Updated message")))) 'replayed)
   (check-equal? (length (storage-order-journal db "alipay" "order")) 1)
   (check-true (projection-result? (storage-project-next! db #:processed-at (current-seconds))))
   (define worker (make-issuance-worker #:catalog catalog #:issuer "test-issuer" #:private-key private #:key-id "test" #:trust-store trust #:evidence-verifier verifier))
   (define issued (process-issuance-work! worker db))
   (check-eq? (issuance-result-disposition issued) 'completed)
   (check-equal? (issuance-result-revision issued) 0)
   (check-false (process-issuance-work! worker db))
   (check-false (storage-project-next! db #:processed-at (current-seconds)))
   (define record (journal-ref db "alipay" "return-query:trade"))
   (check-equal? (journal-record-payload record) raw)
   (check-equal? (record:journal-record-evidence record) (query))
   (verify-issuance-evidence! verifier record "test-offer" "subject")
   (for ([bad (in-list (list (struct-copy record:journal-record record [evidence #f])
                            (struct-copy record:journal-record record [evidence tampered-query])
                            (struct-copy record:journal-record record [payload tampered-return])))])
     (check-exn refused? (lambda () (verify-issuance-evidence! verifier bad "test-offer" "subject"))))
   (define unconfigured (make-issuance-evidence-verifier #:catalog catalog #:alipay-public-key-pem pem #:binding-lookup (lambda (o) (storage-checkout-binding-ref db o))))
   (check-exn refused? (lambda () (verify-issuance-evidence! unconfigured record "test-offer" "subject")))
   (define wrong-merchant (make-issuance-evidence-verifier #:catalog catalog #:alipay-public-key-pem pem #:alipay-app-id "other-app" #:alipay-seller-id "other-seller" #:binding-lookup (lambda (o) (storage-checkout-binding-ref db o))))
   (check-exn refused? (lambda () (verify-issuance-evidence! wrong-merchant record "test-offer" "subject")))
   (check-exn refused? (lambda () (verify-issuance-evidence! verifier record "test-offer" "wrong-subject")))
   (check-exn refused? (lambda () (reconcile-alipay-signed-return! db raw pem (struct-copy alipay-binding binding [subject-id "wrong-subject"]) #:fetch-query (lambda (_) (query)))))
   ;; A late, independently authenticated normal notification must not
   ;; create another rights intent or extend an already issued window.
   (define callback-fields
     (list (cons "app_id" "app") (cons "seller_id" "seller")
       (cons "out_trade_no" "order") (cons "trade_no" "trade")
       (cons "notify_id" "late-notify") (cons "trade_status" "TRADE_SUCCESS")
       (cons "total_amount" "29.00") (cons "gmt_payment" "2026-11-15 19:59:00")
       (cons "sign_type" "RSA2")))
   (define callback (string->bytes/utf-8 (alist->form-urlencoded
     (for/list ([p (in-list (cons (cons "sign" (sign (alipay-signing-content callback-fields))) callback-fields))])
       (cons (string->symbol (car p)) (cdr p))))))
   (define endpoint (make-alipay-webhook-endpoint #:app-id "app" #:seller-id "seller"
     #:alipay-public-key pem #:storage db #:query-order (lambda (_) (query))))
   (define-values (status body) (handle-alipay-webhook-post endpoint callback))
   (check-equal? status 200)
   (check-equal? body #"success")
   (storage-project-next! db #:processed-at (current-seconds))
   (check-equal? (length (storage-order-journal db "alipay" "order")) 2)
   (check-equal? (length (storage-order-outbox db "alipay" "order")) 1)
   (check-false (process-issuance-work! worker db))
   (check-exn refused? (lambda () (reconcile-alipay-signed-return! db raw pem binding #:fetch-query (lambda (_) (query #:time "2026-11-15 20:01:00"))))))
   (lambda () (storage-close db)))) (lambda () (delete-directory/files dir))))
