#lang racket/base
(require rackunit json racket/file racket/port crypto crypto/libcrypto
 commerce/alipay/server commerce/storage commerce/storage/sqlite
 "../examples/alipay-notify-observer.rkt")
(define marker #"PRIVATE_CALLBACK_MARKER_78231")
(define (leaked? bytes) (regexp-match? (byte-regexp (regexp-quote marker)) bytes))
(test-case "encrypted request capture and metadata are lossless and redact raw input"
 (define dir (make-temporary-file "alipay-observer-~a" 'directory))
 (unless (eq? (system-type) 'windows) (file-or-directory-permissions dir #o700))
 (dynamic-wind void (lambda ()
  (define key (crypto-random-bytes 32))
  (define o (make-alipay-notify-observer dir key #:max-records 2))
  (define id (capture-notify! o marker "application/x-www-form-urlencoded; secret=PRIVATE_CALLBACK_MARKER_78231"))
  (define red-path (build-path dir "unsafe-control.log"))
  (call-with-output-file red-path #:permissions #o600 (lambda (out) (write-bytes marker out)))
  (check-true (leaked? (file->bytes red-path)) "red control must detect unsafe artifact")
  (delete-file red-path)
  (define second (capture-notify! o marker "application/x-www-form-urlencoded"))
  (define (envelope id) (call-with-input-file (build-path dir (string-append id ".capture.json")) read-json))
  (check-not-equal? (hash-ref (envelope id) 'nonce) (hash-ref (envelope second) 'nonce))
  (for ([file (in-list (directory-list dir #:build? #t))])
    (check-false (leaked? (file->bytes file)) "green artifacts must not contain raw body/header marker"))
  (check-equal? (read-notify-capture o id) marker)
  (define wrong (make-alipay-notify-observer dir (crypto-random-bytes 32)))
  (check-exn exn:fail? (lambda () (read-notify-capture wrong id)))
  (check-exn exn:fail? (lambda () (read-notify-capture o "../outside")))
  (check-exn exn:fail? (lambda () (capture-notify! o marker "form"))))
  (lambda () (delete-directory/files dir))))
(test-case "observation never authenticates or accepts a malformed payment"
 (define dir (make-temporary-file "alipay-observer-http-~a" 'directory))
 (unless (eq? (system-type) 'windows) (file-or-directory-permissions dir #o700))
 (dynamic-wind void (lambda ()
  (define spool (build-path dir "capture")) (make-directory spool) (unless (eq? (system-type) 'windows) (file-or-directory-permissions spool #o700))
  (define o (make-alipay-notify-observer spool (crypto-random-bytes 32) #:max-body-bytes 64))
  (define storage (open-sqlite-commerce-storage (build-path dir "ledger.sqlite")))
  (dynamic-wind void (lambda ()
   (define edge (make-alipay-webhook-endpoint #:app-id "test" #:seller-id "test" #:alipay-public-key "not-a-live-key"
     #:storage storage #:query-order (lambda (_) (error 'test "must not query unverified input"))))
   (define (status method path type raw)
    (define-values (code body) (handle-observed-alipay-notify o edge method path type raw))
    (check-equal? body #"failure") code)
   (check-equal? (status #"POST" "/webhooks/alipay" "application/x-www-form-urlencoded" marker) 401)
   (check-equal? (status #"POST" "/webhooks/alipay" "application/json; secret=PRIVATE_CALLBACK_MARKER_78231" marker) 415)
   (check-equal? (status #"GET" "/webhooks/alipay" "application/json" marker) 405)
   (check-equal? (status #"POST" "/other" "application/json" marker) 404)
   (check-equal? (status #"POST" "/webhooks/alipay" "application/json" (make-bytes 65 65)) 413)
   (for ([file (in-list (directory-list spool #:build? #t))]) (check-false (leaked? (file->bytes file)))))
   (lambda () (storage-close storage))))
  (lambda () (delete-directory/files dir))))
